# Secrets and local environment configuration
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Private runtime data
backend/data/*
!backend/data/.gitkeep
!backend/data/images/
!backend/data/images/*
!backend/data/icons/
!backend/data/icons/*
.update-lock

# Node/Vite dependencies and build output
**/node_modules/
frontend/dist/
**/.vite/
**/.cache/

# Logs and local runtime files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid

# Docker/local development files
docker-compose.override.yml
.docker/

# Editor and operating-system files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
